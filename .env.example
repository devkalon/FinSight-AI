# FinSight AI — Production Environment Configuration

# Application Settings
PROJECT_NAME="FinSight AI — Personal Finance & Wealth Management Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # Options: development, staging, production
DEBUG=False

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="REQUIRED_GENERATE_RANDOM_32_BYTE_HEX_KEY_FOR_PRODUCTION_JWT"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Whitelist (JSON list of approved origin URLs)
BACKEND_CORS_ORIGINS='["https://finsight.app","https://api.finsight.app"]'

# Database Configuration (Managed PostgreSQL with pgvector)
DATABASE_URL="postgresql+asyncpg://finsight_user:SECURE_DB_PASSWORD@managed-db-host:5432/finsight_db"

# Storage Directory
UPLOAD_DIR="./uploads"

# Optional LLM API Keys (For AI Advisor & RAG Embeddings)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Error Monitoring & Observability (Sentry placeholder)
SENTRY_DSN=""
LOG_LEVEL="INFO"
